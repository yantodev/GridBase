PORT=4173
QUERY_TIMEOUT_MS=30000
DEFAULT_QUERY_LIMIT=50
APP_URL=http://127.0.0.1:4173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opsional: username GitHub yang boleh masuk, dipisahkan koma. Kosong = semua akun GitHub.
GITHUB_ALLOWED_USERS=
# Opsional: ID numerik GitHub tujuan migrasi semua profil SQLite lama tanpa pemilik.
# Ambil field id dari https://api.github.com/users/USERNAME; bukan username.
LEGACY_CONNECTION_OWNER_ID=
# Opsional: ID numerik GitHub admin audit, dipisahkan koma. Kosong = tidak ada admin.
AUDIT_ADMIN_IDS=
