PORT=4173
QUERY_TIMEOUT_MS=30000
DEFAULT_QUERY_LIMIT=50

# Optional startup connection type. The Connection manager in the UI can also
# connect to PostgreSQL, MySQL, or Spark Thrift / Hive without restarting.
# DATABASE_TYPE=postgresql

# Set the optional startup connection credentials here before starting the server.
# Example URL: jdbc:hive2://spark.example:443/default;transportMode=http
# Use single quotes around passwords containing spaces, #, or $.
THRIFT_JDBC_URL=
THRIFT_USERNAME=
THRIFT_PASSWORD=

